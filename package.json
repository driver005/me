		"@theatre/studio": "^0.7.2",
		"@threlte/core": "^8.1.5",
		"@threlte/extras": "^9.5.4",
		"@threlte/flex": "^2.0.6",
		"@threlte/rapier": "^3.1.5",
		"@threlte/studio": "^0.1.9",
		"@threlte/theatre": "^3.0.7",
		"@types/three": "^0.180.0",
		"bits-ui": "^2.15.5",
		"class-variance-authority": "^0.7.1",
